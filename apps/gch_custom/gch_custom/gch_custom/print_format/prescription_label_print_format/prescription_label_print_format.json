 "font": "Default",
 "html": "{% if doc.prescription_table %}\n{%- for row in doc.prescription_table -%}\n<div>\n  <div class=\"row section-break\">\n    <div class=\"row text-center\">\n      <h1>{{ row.item_name|upper }}</h1>\n    </div>\n    <div class=\"row text-center\">\n      <strong\n        >Take {{row.pharmacy_dose}} {{row.unit_of_measure}} every\n        {{row.pharmacy_frequency}} {{row.frequency_type}} for\n        {{row.pharmacy_duration}} Days ({{row.route}}).</strong\n      >\n      <br />\n      {{row.item_description}}\n    </div>\n\n    <div class=\"row\">\n      <div class=\"col\">\n        <h3>{{doc.patient|upper}}</h3>\n        <p>\n          Date: <strong>{{doc.encounter_date}} {{doc.encounter_time}}</strong>\n        </p>\n      </div>\n      <div class=\"col\">\n        <p>DOB: <strong>{{doc.patient_dob}}</strong></p>\n        <p>UHID: <strong>{{doc.patient_uhid}} </strong></p>\n      </div>\n    </div>\n    <div>\n      <h1>GERTRUDE'S CHILDREN'S HOSPITAL</h1>\n      <div class=\"row\">\n        <div class=\"col\"><h3>www.gerties.org</h3></div>\n        <div class=\"col\">Tel : 0708-988-400</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n \n<div class=\"page-break\"></div>\n{%- endfor -%}\n{%- endif -%}",
