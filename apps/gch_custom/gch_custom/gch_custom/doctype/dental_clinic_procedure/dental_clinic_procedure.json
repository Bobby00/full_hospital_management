    {
      "fieldname": "consent",
      "fieldtype": "HTML",
      "hidden": 1,
      "label": "consent",
      "options": "<h4>Parent/Guardian/Patient Declaration</h4>\n<p style=\"font-size: 15px;\">As the parent/guardian/patient, I confirm that</p>\n<ol style=\"font-size: 15px;\">\n  <li>The doctor, anesthetist, or other authorized health professional has explained to me about the procedure.</li>\n  <li>The risks, expected outcomes, benefits, and alternatives of this procedure, and what would happen if the procedure is not performed have been discussed with me, and my questions have been answered to my satisfaction and understanding.</li>\n  <li>I understand that anesthesia services may/will be required and the risks, expected outcomes, benefits, and alternatives, and what would happen if the anesthesia is not performed have been discussed with me and that my questions have been answered to my satisfaction and understanding.</li>\n  <li>I have been given written explanations of the procedure and anesthesia (where applicable).</li>\n  <li>I understand if any tissue, part, limb, or organ is removed, the hospital will dispose of it in accordance with the hospital-approved process.</li>\n  <li>I understand that photography, audio, or visual recordings for the purpose of diagnosis/treatment only may be made.</li>\n</ol>\n<br>\n<p style=\"font-size: 15px;\">Tick approved boxes below</p>",
      "read_only": 1
    },
    {
