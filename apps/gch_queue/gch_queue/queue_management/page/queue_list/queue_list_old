frappe.pages["queue-list"].on_page_load = function (wrapper) {
	new QueueList(wrapper);
};

let queue_items = [];
let priority = "indicator-pill red";
let drug_alergy = "indicator-pill yellow";
let normal = "indicator-pill green";
let index = 1;

const current_queue_items = async () => {
	let g = "";
	const data = await frappe
		.call({
			method:
				"gch_queue.queue_management.page.queue_list.queue.get_current_queues",
			// "gch_queue.services.render_queue",
		})

		.then((result) =>
			result.message.map(
				(k) =>
				(g =
					g +
					`
				<div class="level list-row">
				   <div class="level-left ellipsis">

					  <div class="list-row-col ellipsis list-subject level">

						 <input class="level-item list-row-checkbox hidden-xs" type="checkbox" data-name="${k.patient
					}" >

			 
						 <span class="level-item" style="margin-bottom: 1px;">
							<span class="like-action not-liked" data-name="${k.patient
					}" data-doctype="Patient" data-liked-by="null" title=""></span>
							<span class="likes-count"></span>
						 </span>
						 <span class="level-item bold ellipsis" title="${k.patient}">
						 <a class="ellipsis ${k.is_emergency_patient
						? priority
						: k.is_drug_allergy_patient
							? drug_alergy
							: normal
					}" href="/app/patient/${k.patient}" title=${k.patient
					} data-doctype="Patient" data-name="${k.patient}">
						 ${k.patient}
						 </a>
						 </span>
					  </div>


					  <div class="list-row-col ellipsis hidden-xs ">
						 <span class="ellipsis" title="Service Unit: ${k.is_emergency_patient}">
						 <a class="filterable ellipsis" data-filter="is_emergency_patient,=,${k.is_emergency_patient
					}">
						 ${k.is_emergency_patient
						? "Emergency"
						: k.is_drug_allergy_patient
							? "Drug Alergy"
							: k.is_priority_patient
								? "Priority"
								: k.is_fall_risk_patient
									? "Fall Risk"
									: k.is_isolation_patient
										? "Isolation"
										: "Normal"
					}
						 </a>
						 </span>
					  </div>


					  <div class="list-row-col ellipsis hidden-xs ">
						 <span class="ellipsis" title="Service Unit: ${k.gch_patient_age}">
						 <a class="filterable ellipsis" data-filter="gch_patient_age,=,${k.gch_patient_age}">
						 ${k.gch_patient_age}
						 </a>
						 </span>
					  </div>

					  <div class="list-row-col ellipsis hidden-xs ">
						 <span class="ellipsis" title="Service Unit: ${k.encounter}">
						 <a class="filterable ellipsis" data-filter="encounter,=,${k.encounter}">
						 ${k.encounter}
						 </a>
						 </span>
					  </div>


					  <div class="list-row-col ellipsis hidden-xs ">
						 <span class="ellipsis" title="Service Unit: ${k.service_unit}">
						 <a class="filterable ellipsis" data-filter="service_unit,=,${k.service_unit}">
						 ${k.service_unit}
						 </a>
						 </span>
					  </div>
					  <div class="list-row-col ellipsis hidden-xs ">
						 <span class="ellipsis" title=Name: ${k.queue_position}>
						 <a class="filterable ellipsis" data-filter="queue_position,=,${k.queue_position
					}">

			 	${index++}

						 </a>
						 </span>
					  </div>
				   </div>
				</div>
			 `)
			)
		);

	return g;
};

let OurLoop = async () => await current_queue_items();

